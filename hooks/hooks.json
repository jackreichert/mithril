{
  "hooks": {
    "UserPromptExpansion": [
      {
        "matcher": "^(mithril:)?mithril$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/done-verdict.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(mithril:)?mithril-review$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/done-verdict.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/done-verdict.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
